TRAINER_API_KEY=replace-with-a-long-random-value
CAMOFOX_ACCESS_KEY=replace-with-a-different-long-random-value

# AI is disabled by default. Development recommendation: Groq + Cloudflare review.
TRAINER_OPERATING_MODE=standalone
TRAINER_AGENT_MODE=dual-agent
PRIMARY_AGENT_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=openai/gpt-oss-120b
REVIEW_AGENT_PROVIDER=cloudflare
CLOUDFLARE_AI_API_KEY=replace-with-cloudflare-token
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b

# Optional durable R2 mirror through deploy/cloudflare-storage-worker.js.
CLOUDFLARE_STORAGE_URL=https://crumblr-trainer-storage.example.workers.dev
CLOUDFLARE_STORAGE_TOKEN=replace-with-storage-worker-secret

# Alleen nodig op de Windows-pc waarop MT5 draait.
TRAINER_URL=https://crumblr-static-trainer.onrender.com
TRAINER_WORKER_ID=my-windows-mt5
MT5_TERMINAL=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_EXPERTS_DIR=C:\pad\uit\MT5\File-Open-Data-Folder\MQL5\Experts
